# ============================================
# Web server
# ============================================
APACHE_PORT=80

# 2FA Key
APP_2FA_KEY=#Your2FAKey

# ============================================
# Database
# ============================================
DB_HOST=db
DB_PORT=3306
DB_NAME=duargan_music # Change to your database name

# Add your own credentials
# Frontend user
READER_DB_USER=duargan_reader
READER_DB_PASSWORD=reader_password

# Admin panel user
WRITER_DB_USER=duargan_writer
WRITER_DB_PASSWORD=writer_password

# ============================================
# MySQL variables
# ============================================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=duargan_music
MYSQL_USER=duargan_reader
MYSQL_PASSWORD=reader_password

# ============================================
# phpMyAdmin
# ============================================
PHPMYADMIN_PORT=8080