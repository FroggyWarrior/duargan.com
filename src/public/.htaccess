# PHP Settings to allow larger image uploads (up to 20MB)
<IfModule mod_php.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 20M
    php_value memory_limit 256M
    php_value max_execution_time 300
</IfModule>

RewriteEngine On

# If the user is looking for a real file (like a CSS or JPG), serve the file directly
RewriteCond %{REQUEST_FILENAME} !-f
# If the user is looking for a real directory, serve the directory
RewriteCond %{REQUEST_FILENAME} !-d

# Otherwise, send the request to our Front Controller (index.php)
RewriteRule ^(.*)$ index.php [QSA,L]

# 2FA Key
SetEnv APP_2FA_KEY "base64:br/F2K284KPZMlBOTxKfGUXBC2GFWspHvknEfYVh9Pw="