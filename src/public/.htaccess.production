# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Force HTTPS (if SSL is available)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # If the user is looking for a real file (like a CSS or JPG), serve the file directly
    RewriteCond %{REQUEST_FILENAME} !-f
    # If the user is looking for a real directory, serve the directory
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Otherwise, send the request to our Front Controller (index.php)
    RewriteRule ^(.*)$ index.php [QSA,L]
    
    # Mark admin area for specific headers (CSP relaxation)
    RewriteRule ^admin - [E=ADMIN_AREA:1]
</IfModule>

# ==========================================
# SECURITY HEADERS (Optimized for 100/100 Mozilla Observatory)
# ==========================================
<IfModule mod_headers.c>
    # 1. HSTS (Strict Transport Security) - 2 years max-age for preload robustness
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    
    # 2. Content Security Policy (CSP) - STRICT MODE (Frontend Public)
    # Removed 'unsafe-inline' and 'unsafe-eval' to maximize Observatory score.
    # All JS must be in external .js files (e.g., script.js, song.js).
    # Kept 'unsafe-inline' ONLY for style-src (Material Design 3 dynamic theme injection).
    # Added media-src 'self' data: to allow inline SVGs and base64 media from DB.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    
    # 2b. Content Security Policy (CSP) - RELAXED MODE (Admin Panel Only)
    # Overwrites the strict CSP above ONLY for URLs starting with /admin.
    # Allows 'unsafe-inline' for legacy onclick handlers (close alerts, modals).
    # Allows data: in media-src for SVG previewers and color pickers.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' data:; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self';" env=ADMIN_AREA
    
    # 3. X-Content-Type-Options - Prevents MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # 4. X-Frame-Options - Prevents clickjacking
    Header always set X-Frame-Options "DENY"
    
    # 5. Referrer-Policy - Controls referrer information
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # 6. Permissions-Policy - Controls browser features
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    
    # 7. Cache-Control ONLY for Admin Area (Security)
    # Prevents caching of sensitive admin pages while allowing public frontend caching.
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=ADMIN_AREA
    Header set Pragma "no-cache" env=ADMIN_AREA
    Header set Expires "0" env=ADMIN_AREA
</IfModule>

# ==========================================
# ADDITIONAL SECURITY MEASURES
# ==========================================

# Disable directory browsing
Options -Indexes

# Prevent access to hidden files (like .env, .git, .htaccess)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Protect sensitive files
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op])|~)$">
    Require all denied
</FilesMatch>

# Block access to composer files
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# ==========================================
# PHP SETTINGS (if mod_php is available)
# ==========================================
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    # Note: error_log path depends on your Hostinger username
    # php_value error_log /home/u125731402/logs/php_errors.log
</IfModule>